# Copy this file to .env and fill in your values.
# The application loads .env automatically if python-dotenv is installed.

# OpenAI API key — required for M2 LLM response generation.
# If not set, the response agent returns a controlled no-information response.
OPENAI_API_KEY=

# Optional: override the LLM model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
