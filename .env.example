# Copy this file to .env and fill in your values.
# The application loads .env automatically if python-dotenv is installed.

# OpenAI API key — required for real M2 LLM response generation.
# If not set, the response agent returns a controlled no-information response.
OPENAI_API_KEY=
# LLM provider: openai or gemini
LLM_PROVIDER=gemini

# Gemini API configuration
GEMINI_API_KEY=
# GEMINI_MODEL=<supported-model-name>
# Optional: override the LLM model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: use a project-local Hugging Face cache to avoid Windows user-cache
# permission issues when loading the embedding model.
# HF_HOME=.hf_cache
# HUGGINGFACE_HUB_CACHE=.hf_cache/hub
# TRANSFORMERS_CACHE=.hf_cache/transformers
